PORT=8080
INSTANCE_ID=local

# "standalone" for a single local Redis (default, used by `go run` and CI).
# "sentinel" is what the multi-instance docker-compose stack uses.
REDIS_MODE=standalone
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_USE_TLS=false

# Only read when REDIS_MODE=sentinel
REDIS_SENTINEL_ADDRS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
REDIS_MASTER_NAME=mymaster

RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
