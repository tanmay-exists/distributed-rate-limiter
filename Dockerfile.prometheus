# Stage 1: Copy envsubst binary from alpine
FROM alpine:latest AS builder
RUN apk add --no-cache gettext

# Stage 2: Prometheus agent image
FROM prom/prometheus:latest
COPY --from=builder /usr/bin/envsubst /usr/bin/envsubst
COPY --from=builder /usr/lib/libintl.so* /usr/lib/
COPY prometheus-cloud.yml /etc/prometheus/prometheus-template.yml

USER root

# Reset the entrypoint inherited from base prom/prometheus
ENTRYPOINT []

CMD ["sh", "-c", "envsubst < /etc/prometheus/prometheus-template.yml > /etc/prometheus/prometheus.yml && prometheus --config.file=/etc/prometheus/prometheus.yml --enable-feature=agent"]
